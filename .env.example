# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Paths. On the Pi the installer writes absolute paths under /srv/security_scans.
INCOMING_SCANS_DIR=incoming_scans
TEMPLATE_PATH=templates/template.docx
STATE_DB=state/processed.sqlite3

# Model. gpt-5.4-mini measured more accurate AND cheaper than gpt-4o on these
# handwritten sheets (dates 6/6 vs 0/6 correct; $0.0028 vs $0.0055 per page).
OPENAI_MODEL=gpt-5.4

# Independent readings per page. Handwriting cannot be transcribed perfectly,
# so each page is read several times and disagreements are flagged for a human.
READINGS_PER_PAGE=2

# Resolution used to rasterise PDF pages. 300 measured clearly better than 200.
PDF_DPI=300

# Hard monthly cap on OpenAI spend, enforced before every call. When it is
# reached, scans stay in the incoming folder until the month rolls over.
MONTHLY_BUDGET_EUR=5
EUR_USD=1.10
SPEND_DB=state/spend.sqlite3

# Watch strategy: auto | inotify | polling.
# "auto" polls only when the scan tree is on a network mount, because inotify
# never fires for writes made by an SMB/NFS peer.
WATCH_MODE=auto
POLL_INTERVAL=5

# Seconds to wait for a scan's size to settle before transcribing it.
STABILITY_TIMEOUT=30

# Retry a scan whose processing failed (e.g. the OpenAI API was down).
# RETRY_MAX_ATTEMPTS is the TOTAL number of attempts, not extra retries.
# Transcription and analysis results are cached per scan, so a retry after a
# local fault (full disk, bad template) does not pay for the API again.
RETRY_BASE_DELAY=60
RETRY_MAX_ATTEMPTS=4

# Hide the checks that repeat almost every day so the report shows what
# actually happened. Entries the OCR passes disagreed on are never hidden.
OMIT_ROUTINE=true

# Also write the report into the month folder so the colleague sees it.
WRITE_REPORT_BESIDE_SCAN=true

# Email when a batch has been read and is ready to review in the dashboard,
# or when a scan could not be read. Leave NOTIFY_TO empty to send nothing.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an app password
# (https://myaccount.google.com/apppasswords), never the account password.
NOTIFY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# The address the email's links open. The Pi's mDNS name, not its IP: the
# router hands out addresses by DHCP, and the name follows the Pi.
DASHBOARD_URL=http://nettune.local:8080
# More names the dashboard answers to, comma-separated (its own
# <hostname>.local always works).
# DASHBOARD_HOSTNAMES=
NOTIFY_SETTLE_SECONDS=120
